{
  "name": "adonis-ally-fitbit",
  "description": "Adonis Ally driver for FitBit OAuth2 service",
  "version": "0.0.0",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lint",
    "build": "tsc"
  },
  "devDependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "^24.10.13",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/ally": "^5.0.0-7 || ^6.0.0",
    "@adonisjs/core": "^6.1.5-32 || ^7.0.0"
  },
  "author": "",
  "license": "MIT",
  "keywords": [
    "social-auth",
    "adonisjs-ally",
    "adonisjs"
  ]
